{
  "name": "@frankfmy/async-control",
  "version": "0.2.2",
  "private": true,
  "description": "Small, typed async control primitives for TypeScript.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "oxlint --deny-warnings src test scripts/verify-package-contract.mjs",
    "verify": "bun run lint && bun run check && bun test && bun run build && bun run package:check",
    "prepack": "bun run build",
    "package:check": "node scripts/verify-package-contract.mjs"
  },
  "keywords": [
    "typescript",
    "async",
    "throttle",
    "debounce",
    "promise",
    "activity-tracker",
    "context-fence"
  ],
  "author": { "name": "Artem Prianishnikov", "email": "Pryanishnikovartem@gmail.com", "url": "https://frankfmy.com" },
  "license": "MIT",
  "homepage": "https://github.com/FrankFMY/async-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankFMY/async-control.git"
  },
  "bugs": {
    "url": "https://github.com/FrankFMY/async-control/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0",
    "oxlint": "1.89.0",
    "typescript": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
