  "keywords": ["typescript", "async", "throttle", "debounce", "promise", "activity-tracker"],
  "author": { "name": "Artem Prianishnikov", "email": "Pryanishnikovartem@gmail.com", "url": "https://frankfmy.com" },
  "license": "MIT",
  "homepage": "https://frankfmy.com",
  "repository": { "type": "git", "url": "git+https://github.com/FrankFMY/async-control.git" },
  "bugs": { "url": "https://github.com/FrankFMY/async-control/issues" },
  "engines": { "node": ">=20" },
  "packageManager": "bun@1.4.0",
  "devDependencies": { "@types/bun": "1.4.0", "@types/node": "^24.0.0", "typescript": "^6.0.0" }
}
