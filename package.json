{
  "name": "@frankfmy/async-control",
  "version": "0.1.0",
  "description": "Small, typed async control primitives for TypeScript.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
